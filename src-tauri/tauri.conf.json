{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3db",
  "version": "1.0.0",
  "identifier": "de.3db.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "3db",
        "width": 1240,
        "height": 820,
        "minWidth": 790,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "3db"
}
